/**
 * Scratch Quest — Google Apps Script server.
 *
 * Deploy as a Web App:  Execute as "Me"  |  Who has access: "Anyone within <your school domain>".
 * Students are identified by their school Google account automatically. All data lives in a
 * Google Sheet ("Scratch Quest Data") in YOUR Drive, created the first time the app runs.
 *
 * The game logic lives in Shared.gs (generated by build.js from src/ — the very same code that
 * powers the browser demo). Google Classroom features use the Classroom advanced service
 * (enabled in appsscript.json) and run ONLY for teacher accounts.
 */

// Extra teacher accounts (co-teachers, aides). The account that deploys the script is ALWAYS a teacher.
// Note: Classroom actions always run as the deploying account, so co-teachers see YOUR Classroom classes.
var TEACHER_EMAILS = [
  // 'coteacher@yourschool.org',
];

// The page is split into several HTML files (filled in by build.js). The server checks they exist;
// the page itself checks each one loaded to the end (see the end of Index).
var PAGE_PARTS_ = ["Styles","Shots","Engine"];
var PART_CACHE_ = {};
function part_(name) {
  if (!(name in PART_CACHE_)) {
    try { PART_CACHE_[name] = HtmlService.createHtmlOutputFromFile(name).getContent(); } catch (e) { PART_CACHE_[name] = null; }
  }
  return PART_CACHE_[name] || '';
}

function doGet() {
  // Find the Index page file (accept common naming slips) and check every part file.
  var problems = [], tpl = null, names = ['Index', 'index', 'Index.html', 'index.html'];
  for (var i = 0; i < names.length && !tpl; i++) {
    try { tpl = HtmlService.createTemplateFromFile(names[i]); } catch (e) { tpl = null; }
  }
  if (!tpl) problems.push('<b>Index</b> is missing.');
  PAGE_PARTS_.forEach(function (n) {
    part_(n);
    if (PART_CACHE_[n] === null) problems.push('<b>' + n + '</b> is missing.');
  });
  if (problems.length) {
    return HtmlService.createHtmlOutput(
      '<div style="font:16px/1.5 sans-serif;max-width:600px;margin:40px auto">' +
      '<h2>Scratch Quest is almost ready</h2><p>Some page files need fixing in the Apps Script editor:</p><ul><li>' + problems.join('</li><li>') + '</li></ul>' +
      '<p>To add a page file: click <b>+</b> next to Files, choose <b>HTML</b>, and type its name without ".html" (the editor adds it). Paste the whole file, then save.</p>' +
      '<p>You need these HTML files: <b>Index, ' + PAGE_PARTS_.join(', ') + '</b>.</p>' +
      '<p>Then: <b>Deploy → Manage deployments → Edit → Version: New version → Deploy</b>.</p></div>').setTitle('Scratch Quest setup');
  }
  return tpl.evaluate()
    .setTitle('Scratch Quest')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setFaviconUrl('https://fonts.gstatic.com/s/e/notoemoji/latest/1f9ed/512.png');
}

/** Run this once from the editor (select "setup" ▸ Run) to create the data sheet and grant permissions. */
function setup() {
  var ss = db_();
  Logger.log('Scratch Quest data sheet: ' + ss.getUrl());
  try {
    var n = (Classroom.Courses.list({ teacherId: 'me', courseStates: ['ACTIVE'], pageSize: 5 }).courses || []).length;
    Logger.log('Google Classroom connected. You teach ' + n + '+ active classes.');
  } catch (e) {
    Logger.log('Google Classroom is not available (' + e.message + '). The app still works without it.');
  }
}

var CLASSROOM_ACTIONS_ = { classroomCourses: 1, classroomImport: 1, classroomPost: 1, classroomUnlink: 1 };
var READ_ONLY_ = { bootstrap: 1, classView: 1, teacherData: 1, classroomCourses: 1, lessons: 1, classScreen: 1 };

/** Single entry point used by the web page: google.script.run.api(action, args). */
function api(action, args) {
  var user = currentUser_();
  var store = sheetStore_();
  var handler;
  if (CLASSROOM_ACTIONS_[action]) {
    // Classroom calls run with the teacher's permissions, so never let a student reach them.
    if (!user.isTeacher) throw new Error('Teachers only.');
    handler = SQ_CLASSROOM(store, classroomAdapter_());
  } else {
    handler = SQ_SERVICE(store);
  }
  if (!Object.prototype.hasOwnProperty.call(handler, action) || typeof handler[action] !== 'function') throw new Error('Unknown action: ' + action);
  if (READ_ONLY_[action]) return handler[action](user, args || {});
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    return handler[action](user, args || {});
  } finally {
    SpreadsheetApp.flush();
    lock.releaseLock();
  }
}

function currentUser_() {
  var email = (Session.getActiveUser().getEmail() || '').toLowerCase();
  if (!email) throw new Error('Please sign in with your school Google account, then reload this page.');
  var owner = (Session.getEffectiveUser().getEmail() || '').toLowerCase();
  var teachers = TEACHER_EMAILS.map(function (e) { return String(e).toLowerCase(); });
  var local = email.split('@')[0].split(/[._\d]/)[0] || 'Coder';
  return {
    email: email,
    name: local.charAt(0).toUpperCase() + local.slice(1),
    isTeacher: email === owner || teachers.indexOf(email) >= 0
  };
}

// ------------------------------------------------------------------ Google Classroom adapter
function classroomAdapter_() {
  function all(fetchPage, key) {
    var out = [], token = null, guard = 0;
    do {
      var page = fetchPage(token) || {};
      out = out.concat(page[key] || []);
      token = page.nextPageToken;
    } while (token && ++guard < 50);
    return out;
  }
  function call(fn) {
    try { return fn(); } catch (e) {
      var m = String(e && e.message || e);
      if (/disabled|has not been used|not enabled/i.test(m)) throw new Error('The Google Classroom API is turned off for this script or your school. Ask your Google admin, or see the README.');
      if (/permission|forbidden|403/i.test(m)) throw new Error('Google Classroom said no: you may not be a teacher in that class.');
      throw new Error('Google Classroom error: ' + m);
    }
  }
  return {
    listCourses: function () {
      return call(function () {
        return all(function (t) { return Classroom.Courses.list({ teacherId: 'me', courseStates: ['ACTIVE'], pageSize: 100, pageToken: t }); }, 'courses')
          .map(function (c) { return { id: String(c.id), name: c.name, section: c.section || '', link: c.alternateLink || '' }; });
      });
    },
    listStudents: function (courseId) {
      return call(function () {
        return all(function (t) { return Classroom.Courses.Students.list(courseId, { pageSize: 100, pageToken: t }); }, 'students')
          .map(function (s) {
            var p = s.profile || {}, n = p.name || {};
            // Only what we need: email (identity) and the name parts used to make "First L."
            return { email: p.emailAddress || '', given: n.givenName || (n.fullName || '').split(' ')[0], family: n.familyName || '' };
          });
      });
    },
    ensureTopic: function (courseId, name) {
      return call(function () {
        var found = all(function (t) { return Classroom.Courses.Topics.list(courseId, { pageSize: 100, pageToken: t }); }, 'topic')
          .filter(function (tp) { return tp.name === name; })[0];
        return found ? found.topicId : Classroom.Courses.Topics.create({ name: name }, courseId).topicId;
      });
    },
    createCourseWork: function (courseId, cw) {
      return call(function () {
        var made = Classroom.Courses.CourseWork.create(cw, courseId);
        return { id: made.id, link: made.alternateLink || '' };
      });
    },
    appUrl: function () {
      try { return ScriptApp.getService().getUrl() || ''; } catch (e) { return ''; }
    }
  };
}

// ------------------------------------------------------------------ Sheets storage
var SHEETS_ = {
  Classes: ['id', 'name', 'code', 'data (do not edit)'],
  Students: ['email', 'name', 'classId', 'xp', 'level', 'quests done', 'current quest', 'last active', 'data (do not edit)'],
  Settings: ['key', 'value'],
  Progress: null // built from the quest list; a read-only view for you (rewritten as students work)
};
var STATUS_MARK_ = { done: '✔', submitted: '📨 turned in', returned: '↩ sent back', started: '… working' };

function progressHeader_() {
  return ['email', 'name', 'class', 'level', 'xp', 'quests done', 'last active'].concat(SQ_RULES.NODES.map(function (n) {
    return 'Q' + n.tier + ' ' + SQ_LESSONS[n.id].title;
  }));
}

function db_() {
  var props = PropertiesService.getScriptProperties();
  var id = props.getProperty('DB_ID'), ss = null;
  if (id) { try { ss = SpreadsheetApp.openById(id); } catch (e) { ss = null; } }
  if (!ss) {
    ss = SpreadsheetApp.create('Scratch Quest Data');
    props.setProperty('DB_ID', ss.getId());
  }
  Object.keys(SHEETS_).forEach(function (name) {
    var header = SHEETS_[name] || progressHeader_();
    var sh = ss.getSheetByName(name);
    if (!sh) {
      sh = ss.insertSheet(name);
      sh.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight('bold');
      sh.setFrozenRows(1);
    } else if (name === 'Progress') {
      var cur = sh.getRange(1, 1, 1, header.length).getValues()[0];
      if (cur.join('|') !== header.join('|')) sh.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight('bold');
    }
  });
  var def = ss.getSheetByName('Sheet1');
  if (def && ss.getSheets().length > 1) ss.deleteSheet(def);
  return ss;
}

function sheetStore_() {
  var ss = db_();
  var cache = {};
  function width(name) { return (SHEETS_[name] || progressHeader_()).length; }
  function rows(name) {
    if (cache[name]) return cache[name];
    var sh = ss.getSheetByName(name);
    var last = sh.getLastRow();
    var vals = last > 1 ? sh.getRange(2, 1, last - 1, width(name)).getValues() : [];
    cache[name] = vals;
    return vals;
  }
  function findRow(name, key) {
    var r = rows(name);
    for (var i = 0; i < r.length; i++) if (String(r[i][0]).toLowerCase() === String(key).toLowerCase()) return i;
    return -1;
  }
  function upsert(name, key, values) {
    var sh = ss.getSheetByName(name), i = findRow(name, key);
    if (i >= 0) {
      sh.getRange(i + 2, 1, 1, values.length).setValues([values]);
      cache[name][i] = values;
    } else {
      sh.appendRow(values);
      rows(name).push(values);
    }
  }
  function remove(name, key) {
    var i = findRow(name, key);
    if (i >= 0) { ss.getSheetByName(name).deleteRow(i + 2); cache[name].splice(i, 1); }
  }
  function parse(s, fallback) { try { return JSON.parse(s); } catch (e) { return fallback; } }
  function className(id) { var r = rows('Classes'); for (var i = 0; i < r.length; i++) if (String(r[i][0]) === String(id)) return String(r[i][1]); return ''; }
  function progressRow(s) {
    var st = s.state || SQ_RULES.newState();
    return [s.email, s.name, className(s.classId), s.level || 1, s.xp || 0, s.doneCount || 0, new Date(s.updated || Date.now())].concat(
      SQ_RULES.NODES.map(function (n) { return STATUS_MARK_[SQ_RULES.nodeStatus(st, n.id)] || ''; }));
  }

  var store = {
    getClasses: function () {
      return rows('Classes').map(function (r) {
        var c = parse(r[3], {});
        c.id = String(r[0]); c.name = String(r[1]); c.code = String(r[2]);
        return c;
      });
    },
    saveClass: function (c) { upsert('Classes', c.id, [c.id, c.name, c.code, JSON.stringify(c)]); },
    deleteClass: function (id) { remove('Classes', id); },
    getStudents: function () {
      return rows('Students').map(function (r) {
        var s = parse(r[8], {});
        s.email = String(r[0]); s.name = String(r[1]); s.classId = String(r[2]);
        s.state = s.state || SQ_RULES.newState();
        return s;
      });
    },
    getStudent: function (email) {
      var i = findRow('Students', email);
      if (i < 0) return null;
      return store.getStudents()[i];
    },
    saveStudent: function (s) {
      upsert('Students', s.email, [s.email, s.name, s.classId, s.xp || 0, s.level || 1, s.doneCount || 0,
        s.current || '', new Date(s.updated || Date.now()), JSON.stringify(s)]);
      if (!s.isTeacher) upsert('Progress', s.email, progressRow(s));
    },
    deleteStudent: function (email) { remove('Students', email); remove('Progress', email); },
    getSettings: function () {
      var out = {};
      rows('Settings').forEach(function (r) { out[r[0]] = parse(r[1], r[1]); });
      return out;
    },
    saveSettings: function (obj) {
      Object.keys(obj).forEach(function (k) { upsert('Settings', k, [k, JSON.stringify(obj[k])]); });
    }
  };
  return store;
}
