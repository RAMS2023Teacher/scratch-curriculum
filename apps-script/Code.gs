/**
 * Scratch Quest — Google Apps Script server.
 *
 * Deploy as a Web App:  Execute as "Me"  |  Who has access: "Anyone within <your school domain>".
 * Students are identified by their school Google account automatically. All data lives in a
 * Google Sheet ("Scratch Quest Data") in YOUR Drive, created the first time the app runs.
 *
 * The game logic lives in Shared.gs (generated by build.js from src/ — the very same code that
 * powers the browser demo). Google Classroom features use the Classroom advanced service
 * (enabled in appsscript.json) and run ONLY for teacher accounts.
 */

// Extra teacher accounts (co-teachers, aides). The account that deploys the script is ALWAYS a teacher.
// Note: Classroom actions always run as the deploying account, so co-teachers see YOUR Classroom classes.
// How often a backup copy of the data sheet is saved to your Google Drive (in days).
// Backups are named "Scratch Quest Backup <date>"; delete old ones from Drive whenever you like.
var BACKUP_EVERY_DAYS = 1;

var TEACHER_EMAILS = [
  // 'coteacher@yourschool.org',
];

// The page is split into several HTML files (filled in by build.js). The server checks they exist;
// the page itself checks each one loaded to the end (see the end of Index).
var PAGE_PARTS_ = /*{{PARTS}}*/[];
var PART_CACHE_ = {};
function part_(name) {
  if (!(name in PART_CACHE_)) {
    try { PART_CACHE_[name] = HtmlService.createHtmlOutputFromFile(name).getContent(); } catch (e) { PART_CACHE_[name] = null; }
  }
  return PART_CACHE_[name] || '';
}

function doGet() {
  // Find the Index page file (accept common naming slips) and check every part file.
  var problems = [], tpl = null, names = ['Index', 'index', 'Index.html', 'index.html'];
  for (var i = 0; i < names.length && !tpl; i++) {
    try { tpl = HtmlService.createTemplateFromFile(names[i]); } catch (e) { tpl = null; }
  }
  if (!tpl) problems.push('<b>Index</b> is missing.');
  PAGE_PARTS_.forEach(function (n) {
    part_(n);
    if (PART_CACHE_[n] === null) problems.push('<b>' + n + '</b> is missing.');
  });
  if (problems.length) {
    return HtmlService.createHtmlOutput(
      '<div style="font:16px/1.5 sans-serif;max-width:600px;margin:40px auto">' +
      '<h2>Scratch Quest is almost ready</h2><p>Some page files need fixing in the Apps Script editor:</p><ul><li>' + problems.join('</li><li>') + '</li></ul>' +
      '<p>To add a page file: click <b>+</b> next to Files, choose <b>HTML</b>, and type its name without ".html" (the editor adds it). Paste the whole file, then save.</p>' +
      '<p>You need these HTML files: <b>Index, ' + PAGE_PARTS_.join(', ') + '</b>.</p>' +
      '<p>Then: <b>Deploy → Manage deployments → Edit → Version: New version → Deploy</b>.</p></div>').setTitle('Scratch Quest setup');
  }
  return tpl.evaluate()
    .setTitle('Scratch Quest')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setFaviconUrl('https://fonts.gstatic.com/s/e/notoemoji/latest/1f9ed/512.png');
}

/** Run this once from the editor (select "setup" ▸ Run) to create the data sheet and grant permissions. */
function setup() {
  var ss = db_();
  Logger.log('Scratch Quest data sheet: ' + ss.getUrl());
  try {
    var n = (Classroom.Courses.list({ teacherId: 'me', courseStates: ['ACTIVE'], pageSize: 5 }).courses || []).length;
    Logger.log('Google Classroom connected. You teach ' + n + '+ active classes.');
  } catch (e) {
    Logger.log('Google Classroom is not available (' + e.message + '). The app still works without it.');
  }
}

var CLASSROOM_ACTIONS_ = { classroomCourses: 1, classroomImport: 1, classroomPost: 1, classroomUnlink: 1, classroomRestore: 1 };
var NO_LOCK_ = { translate: 1, reportBug: 1, askHelp: 0 };
var READ_ONLY_ = { bootstrap: 1, classView: 1, teacherData: 1, classroomCourses: 1, lessons: 1, classScreen: 1, arcade: 1, arcadeBoardFor: 1, myHelp: 1, helpList: 1, bugList: 1, pendingReviews: 1 };

/** Single entry point used by the web page: google.script.run.api(action, args). */
function api(action, args) {
  var user = currentUser_();
  // Data safety tools: only the person who owns this script may use them
  if (action === 'dataInfo' || action === 'dataReconnect' || action === 'dataBackupNow' || action === 'dataMerge') {
    if (user.email !== (Session.getEffectiveUser().getEmail() || '').toLowerCase()) throw new Error('Only the owner of this Scratch Quest can do that.');
    if (action === 'dataReconnect') return dataReconnect_(args || {});
    if (action === 'dataMerge') return dataMerge_(args || {});
    if (action === 'dataBackupNow') { PropertiesService.getScriptProperties().deleteProperty('LAST_BACKUP'); maybeBackup_(db_()); }
    return dataInfo_();
  }
  var store = sheetStore_();
  var handler;
  if (CLASSROOM_ACTIONS_[action]) {
    // Classroom calls run with the teacher's permissions, so never let a student reach them.
    if (!user.isTeacher) throw new Error('Teachers only.');
    handler = SQ_CLASSROOM(store, classroomAdapter_());
  } else {
    handler = SQ_SERVICE(store);
  }
  if (!Object.prototype.hasOwnProperty.call(handler, action) || typeof handler[action] !== 'function') throw new Error('Unknown action: ' + action);
  if (action === 'teacherData' && user.isTeacher) maybeBackup_(db_());
  // Reads, translation and bug reports don't take the write lock, so they never hold up students' saves
  if (READ_ONLY_[action] || NO_LOCK_[action]) return handler[action](user, args || {});
  var lock = LockService.getScriptLock();
  try { lock.waitLock(25000); }
  catch (e) { throw new Error('BUSY: Scratch Quest is very busy right now. Your work is safe. Trying again...'); }
  try {
    return handler[action](user, args || {});
  } finally {
    SpreadsheetApp.flush();
    lock.releaseLock();
  }
}

function currentUser_() {
  var email = (Session.getActiveUser().getEmail() || '').toLowerCase();
  if (!email) throw new Error('Please sign in with your school Google account, then reload this page.');
  var owner = (Session.getEffectiveUser().getEmail() || '').toLowerCase();
  var teachers = TEACHER_EMAILS.map(function (e) { return String(e).toLowerCase(); });
  var local = email.split('@')[0].split(/[._\d]/)[0] || 'Coder';
  return {
    email: email,
    name: local.charAt(0).toUpperCase() + local.slice(1),
    isTeacher: email === owner || teachers.indexOf(email) >= 0
  };
}

// ------------------------------------------------------------------ Google Classroom adapter
function classroomAdapter_() {
  function all(fetchPage, key) {
    var out = [], token = null, guard = 0;
    do {
      var page = fetchPage(token) || {};
      out = out.concat(page[key] || []);
      token = page.nextPageToken;
    } while (token && ++guard < 50);
    return out;
  }
  function call(fn) {
    try { return fn(); } catch (e) {
      var m = String(e && e.message || e);
      if (/disabled|has not been used|not enabled/i.test(m)) throw new Error('The Google Classroom API is turned off for this script or your school. Ask your Google admin, or see the README.');
      if (/permission|forbidden|403/i.test(m)) throw new Error('Google Classroom said no: you may not be a teacher in that class.');
      throw new Error('Google Classroom error: ' + m);
    }
  }
  return {
    listCourses: function () {
      return call(function () {
        return all(function (t) { return Classroom.Courses.list({ teacherId: 'me', courseStates: ['ACTIVE'], pageSize: 100, pageToken: t }); }, 'courses')
          .map(function (c) { return { id: String(c.id), name: c.name, section: c.section || '', link: c.alternateLink || '' }; });
      });
    },
    listStudents: function (courseId) {
      return call(function () {
        return all(function (t) { return Classroom.Courses.Students.list(courseId, { pageSize: 100, pageToken: t }); }, 'students')
          .map(function (s) {
            var p = s.profile || {}, n = p.name || {};
            // Only what we need: email (identity) and the name parts used to make "First L."
            return { email: p.emailAddress || '', given: n.givenName || (n.fullName || '').split(' ')[0], family: n.familyName || '' };
          });
      });
    },
    ensureTopic: function (courseId, name) {
      return call(function () {
        var found = all(function (t) { return Classroom.Courses.Topics.list(courseId, { pageSize: 100, pageToken: t }); }, 'topic')
          .filter(function (tp) { return tp.name === name; })[0];
        return found ? found.topicId : Classroom.Courses.Topics.create({ name: name }, courseId).topicId;
      });
    },
    createCourseWork: function (courseId, cw) {
      return call(function () {
        var made = Classroom.Courses.CourseWork.create(cw, courseId);
        return { id: made.id, link: made.alternateLink || '' };
      });
    },
    appUrl: function () {
      try { return ScriptApp.getService().getUrl() || ''; } catch (e) { return ''; }
    }
  };
}

// ------------------------------------------------------------------ Sheets storage
var SHEETS_ = {
  Classes: ['id', 'name', 'code', 'data (do not edit)'],
  Students: ['email', 'name', 'classId', 'xp', 'level', 'quests done', 'current quest', 'last active', 'data (do not edit)'],
  Settings: ['key', 'value'],
  Bugs: ['id', 'when', 'status', 'name', 'email', 'class', 'where', 'what happened', 'data (do not edit)'],
  Translations: ['key (do not edit)', 'language', 'English', 'translation (you can edit this)'],
  Progress: null // built from the quest list; a read-only view for you (rewritten as students work)
};
var STATUS_MARK_ = { done: '✔', submitted: '📨 turned in', returned: '↩ sent back', started: '… working' };

function progressHeader_() {
  return ['email', 'name', 'class', 'level', 'xp', 'quests done', 'last active'].concat(SQ_RULES.NODES.map(function (n) {
    return 'Q' + n.tier + ' ' + SQ_LESSONS[n.id].title;
  }));
}

// IMPORTANT: once a data sheet exists, this NEVER creates a replacement. If Google is too busy to
// open the sheet, the request fails with a "try again" message instead (the page retries by itself).
// A new sheet is only made on the very first run, or when the owner asks for one (Classes page).
function db_() {
  var props = PropertiesService.getScriptProperties();
  var id = props.getProperty('DB_ID'), ss = null;
  if (id) {
    for (var i = 0; i < 4 && !ss; i++) {
      try { ss = SpreadsheetApp.openById(id); } catch (e) { ss = null; Utilities.sleep(300 * (i + 1)); }
    }
    if (!ss) throw new Error('BUSY: Scratch Quest is very busy right now. Your work is safe. Trying again...');
  } else {
    // first run: take a lock so two first visitors can't each make a sheet
    var lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      id = props.getProperty('DB_ID');
      ss = id ? SpreadsheetApp.openById(id) : newDataSheet_(props);
    } finally { lock.releaseLock(); }
  }
  // Tabs and headers only need checking when the app version changes (not on every request)
  var schema = JSON.stringify(SHEETS_) + '|' + progressHeader_().length;
  if (props.getProperty('SCHEMA_' + ss.getId()) !== schema) { ensureTabs_(ss); props.setProperty('SCHEMA_' + ss.getId(), schema); }
  return ss;
}
function newDataSheet_(props) {
  var ss = SpreadsheetApp.create('Scratch Quest Data');
  rememberSheet_(props, ss.getId());
  props.setProperty('DB_ID', ss.getId());
  return ss;
}
// Keep a list of every data sheet this app has used, so one can always be found again
function rememberSheet_(props, id) {
  var hist = [];
  try { hist = JSON.parse(props.getProperty('DB_HISTORY') || '[]'); } catch (e) { hist = []; }
  if (hist.indexOf(id) < 0) { hist.push(id); props.setProperty('DB_HISTORY', JSON.stringify(hist.slice(-12))); }
}
function ensureTabs_(ss) {
  Object.keys(SHEETS_).forEach(function (name) {
    var header = SHEETS_[name] || progressHeader_();
    var sh = ss.getSheetByName(name);
    if (!sh) {
      sh = ss.insertSheet(name);
      sh.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight('bold');
      sh.setFrozenRows(1);
    } else if (name === 'Progress') {
      var cur = sh.getRange(1, 1, 1, header.length).getValues()[0];
      if (cur.join('|') !== header.join('|')) sh.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight('bold');
    }
  });
  var def = ss.getSheetByName('Sheet1');
  if (def && ss.getSheets().length > 1) ss.deleteSheet(def);
}

// ------------------------------------------------------------------ data safety (owner only)
function sheetSummary_(ss) {
  var count = function (name) { var sh = ss.getSheetByName(name); return sh ? Math.max(0, sh.getLastRow() - 1) : -1; };
  return { id: ss.getId(), name: ss.getName(), url: ss.getUrl(), classes: count('Classes'), students: count('Students') };
}
function dataInfo_() {
  var props = PropertiesService.getScriptProperties(), id = props.getProperty('DB_ID'), out = { current: null, others: [], backups: [] };
  var hist = []; try { hist = JSON.parse(props.getProperty('DB_HISTORY') || '[]'); } catch (e) { hist = []; }
  if (id) { try { out.current = sheetSummary_(SpreadsheetApp.openById(id)); } catch (e) { out.current = { id: id, error: true }; } }
  hist.forEach(function (h) { if (h !== id) { try { out.others.push(sheetSummary_(SpreadsheetApp.openById(h))); } catch (e) { } } });
  try { out.backups = JSON.parse(props.getProperty('BACKUPS') || '[]'); } catch (e) { out.backups = []; }
  return out;
}
// Point the app at a data sheet the owner chooses (a link from Drive, or an id from the list)
function dataReconnect_(args) {
  var props = PropertiesService.getScriptProperties(), ss;
  var ref = String(args.sheet || '').trim();
  try { ss = /^https?:/.test(ref) ? SpreadsheetApp.openByUrl(ref) : SpreadsheetApp.openById(ref); }
  catch (e) { throw new Error('Could not open that spreadsheet. Paste the full link from your browser\'s address bar, and make sure you own it.'); }
  if (!ss.getSheetByName('Students') || !ss.getSheetByName('Classes')) throw new Error('That spreadsheet is not a Scratch Quest data sheet (it has no Classes and Students tabs).');
  var old = props.getProperty('DB_ID');
  if (old) rememberSheet_(props, old);
  rememberSheet_(props, ss.getId());
  props.setProperty('DB_ID', ss.getId());
  return dataInfo_();
}
// Bring everything from another data sheet into the current one (nothing is removed; see SQ_MERGE).
// args.apply = false only reports what would happen.
function dataMerge_(args) {
  var ref = String(args.sheet || '').trim(), src, cur = db_();
  try { src = /^https?:/.test(ref) ? SpreadsheetApp.openByUrl(ref) : SpreadsheetApp.openById(ref); }
  catch (e) { throw new Error('Could not open that spreadsheet. Paste the full link from your browser\'s address bar, and make sure you own it.'); }
  if (!src.getSheetByName('Students') || !src.getSheetByName('Classes')) throw new Error('That spreadsheet is not a Scratch Quest data sheet (it has no Classes and Students tabs).');
  if (src.getId() === cur.getId()) throw new Error('That is the sheet the app is already using. Paste the link to the OTHER Scratch Quest Data sheet.');
  var props = PropertiesService.getScriptProperties();
  rememberSheet_(props, src.getId());
  if (!args.apply) return { report: SQ_MERGE(sheetStore_(cur), sheetStore_(src), false, src.getId()), from: sheetSummary_(src) };
  var lock = LockService.getScriptLock();
  try { lock.waitLock(28000); } catch (e) { throw new Error('BUSY: Scratch Quest is very busy right now. Try again in a moment.'); }
  try {
    // keep a copy of the current sheet first, so this can always be undone
    var day = Utilities.formatDate(new Date(), 'America/New_York', 'yyyy-MM-dd HH:mm');
    var copy = cur.copy('Scratch Quest Backup ' + day + ' (before combining)');
    var list = []; try { list = JSON.parse(props.getProperty('BACKUPS') || '[]'); } catch (e) { list = []; }
    list.push({ id: copy.getId(), url: copy.getUrl(), day: day, students: Math.max(0, cur.getSheetByName('Students').getLastRow() - 1) });
    props.setProperty('BACKUPS', JSON.stringify(list.slice(-8)));
    var report = SQ_MERGE(sheetStore_(cur), sheetStore_(src), true, src.getId());
    SpreadsheetApp.flush();
    return { report: report, done: true, info: dataInfo_() };
  } finally { lock.releaseLock(); }
}
// A copy of the data sheet every BACKUP_EVERY_DAYS days (made when the teacher opens the app)
function maybeBackup_(ss) {
  try {
    var props = PropertiesService.getScriptProperties(), last = Number(props.getProperty('LAST_BACKUP') || 0);
    if (Date.now() - last < (BACKUP_EVERY_DAYS - 0.3) * 864e5) return;
    var sh = ss.getSheetByName('Students');
    if (!sh || sh.getLastRow() < 2) return; // nothing worth copying yet
    props.setProperty('LAST_BACKUP', String(Date.now()));
    var day = Utilities.formatDate(new Date(), 'America/New_York', 'yyyy-MM-dd');
    var copy = ss.copy('Scratch Quest Backup ' + day);
    var list = []; try { list = JSON.parse(props.getProperty('BACKUPS') || '[]'); } catch (e) { list = []; }
    list.push({ id: copy.getId(), url: copy.getUrl(), day: day, students: sh.getLastRow() - 1 });
    props.setProperty('BACKUPS', JSON.stringify(list.slice(-8)));
  } catch (e) { /* a backup must never break the app */ }
}

function bugRow_(b) {
  return [b.id, new Date(b.at), b.status + (b.auto ? ' (auto)' : ''), b.name, b.email, b.cls, b.where, b.text, JSON.stringify(b)];
}

function sheetStore_(other) {
  var ss = other || db_();
  var cache = {};
  function width(name) { return (SHEETS_[name] || progressHeader_()).length; }
  function rows(name) {
    if (cache[name]) return cache[name];
    var sh = ss.getSheetByName(name);
    var last = sh.getLastRow();
    var vals = last > 1 ? sh.getRange(2, 1, last - 1, width(name)).getValues() : [];
    cache[name] = vals;
    return vals;
  }
  function findRow(name, key) {
    var r = rows(name);
    for (var i = 0; i < r.length; i++) if (String(r[i][0]).toLowerCase() === String(key).toLowerCase()) return i;
    return -1;
  }
  // Find ONE row by its key without reading the whole tab (the tab can hold hundreds of students).
  // Returns the sheet row number, or -1.
  function fastRow(name, key) {
    var sh = ss.getSheetByName(name), last = sh.getLastRow();
    if (last < 2) return -1;
    var cell = sh.getRange(2, 1, last - 1, 1).createTextFinder(String(key)).matchEntireCell(true).matchCase(false).findNext();
    return cell ? cell.getRow() : -1;
  }
  function upsert(name, key, values) {
    var sh = ss.getSheetByName(name);
    if (!cache[name]) { // the tab has not been read in this request: touch only the one row
      var r = fastRow(name, key);
      if (r > 0) sh.getRange(r, 1, 1, values.length).setValues([values]); else sh.appendRow(values);
      return;
    }
    var i = findRow(name, key);
    if (i >= 0) {
      sh.getRange(i + 2, 1, 1, values.length).setValues([values]);
      cache[name][i] = values;
    } else {
      sh.appendRow(values);
      rows(name).push(values);
    }
  }
  function remove(name, key) {
    if (!cache[name]) { var r = fastRow(name, key); if (r > 0) ss.getSheetByName(name).deleteRow(r); return; }
    var i = findRow(name, key);
    if (i >= 0) { ss.getSheetByName(name).deleteRow(i + 2); cache[name].splice(i, 1); }
  }
  // A saved record that cannot be read must NEVER be replaced by a blank one. If the data cell has
  // text that does not parse, single-student actions stop with an error, and list views mark the
  // record as unreadable; either way it is not saved over.
  function readRecord(text, what, strict) {
    if (text === '' || text == null) return {};
    try { return JSON.parse(text); }
    catch (e) {
      if (strict) throw new Error('The saved record for ' + what + ' could not be read, so nothing was changed. Tell your teacher.');
      return { unreadable: true };
    }
  }
  function studentFromRow(r, strict) {
    var s = readRecord(r[8], r[1] || r[0], strict);
    s.email = String(r[0]); s.name = String(r[1]); s.classId = String(r[2]);
    s.state = s.state || SQ_RULES.newState();
    return s;
  }
  function parse(s, fallback) { try { return JSON.parse(s); } catch (e) { return fallback; } }
  function className(id) { var r = rows('Classes'); for (var i = 0; i < r.length; i++) if (String(r[i][0]) === String(id)) return String(r[i][1]); return ''; }
  function progressRow(s) {
    var st = s.state || SQ_RULES.newState();
    return [s.email, s.name, className(s.classId), s.level || 1, s.xp || 0, s.doneCount || 0, new Date(s.updated || Date.now())].concat(
      SQ_RULES.NODES.map(function (n) { return STATUS_MARK_[SQ_RULES.nodeStatus(st, n.id)] || ''; }));
  }

  var store = {
    getClasses: function () {
      return rows('Classes').map(function (r) {
        var c = readRecord(r[3], r[1], false);
        c.id = String(r[0]); c.name = String(r[1]); c.code = String(r[2]);
        return c;
      });
    },
    saveClass: function (c) { if (c.unreadable) throw new Error('This class record could not be read, so it was not changed.'); upsert('Classes', c.id, [c.id, c.name, c.code, JSON.stringify(c)]); },
    deleteClass: function (id) { remove('Classes', id); },
    getStudents: function () { return rows('Students').map(function (r) { return studentFromRow(r, false); }); },
    getStudent: function (email) {
      if (cache.Students) { var i = findRow('Students', email); return i < 0 ? null : studentFromRow(cache.Students[i], true); }
      var r = fastRow('Students', email);
      if (r < 0) return null;
      return studentFromRow(ss.getSheetByName('Students').getRange(r, 1, 1, width('Students')).getValues()[0], true);
    },
    // short-lived shared memory for answers many students ask for at once (e.g. the class map)
    cacheGet: function (key) { try { var v = CacheService.getScriptCache().get(key); return v ? JSON.parse(v) : null; } catch (e) { return null; } },
    cachePut: function (key, value, seconds) { try { var t = JSON.stringify(value); if (t.length < 90000) CacheService.getScriptCache().put(key, t, seconds); } catch (e) { } },
    saveStudent: function (s) {
      if (s.unreadable) throw new Error('This record could not be read, so it was not changed.');
      upsert('Students', s.email, [s.email, s.name, s.classId, s.xp || 0, s.level || 1, s.doneCount || 0,
        s.current || '', new Date(s.updated || Date.now()), JSON.stringify(s)]);
      if (!s.isTeacher) upsert('Progress', s.email, progressRow(s));
    },
    deleteStudent: function (email) { remove('Students', email); remove('Progress', email); },
    getSettings: function () {
      var out = {};
      rows('Settings').forEach(function (r) { out[r[0]] = parse(r[1], r[1]); });
      return out;
    },
    saveSettings: function (obj) {
      Object.keys(obj).forEach(function (k) { upsert('Settings', k, [k, JSON.stringify(obj[k])]); });
    },
    // ---- bug reports (one row each in the Bugs tab)
    bugAll: function () { return rows('Bugs').map(function (r) { return parse(r[8], null); }).filter(Boolean); },
    bugAdd: function (b) { upsert('Bugs', b.id, bugRow_(b)); },
    bugSave: function (b) { upsert('Bugs', b.id, bugRow_(b)); },
    bugDelete: function (id) { remove('Bugs', id); },
    // ---- translation: Google Translate, remembered in the Translations tab (edit column D to correct one)
    translate: function (list, lang) {
      var cache = CacheService.getScriptCache(), known = {}, add = [], started = Date.now(), loaded = false;
      var keyOf = function (x) { return lang + (x.html ? '|h|' : '|t|') + x.t; };
      var ck = function (k) { return 'tr' + Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, k, Utilities.Charset.UTF_8)); };
      var hits = {};
      try { hits = cache.getAll(list.map(function (x) { return ck(keyOf(x)); })) || {}; } catch (e) { hits = {}; }
      var out = list.map(function (x) {
        var key = keyOf(x), c = hits[ck(key)];
        if (c != null) return c;
        if (!loaded) { loaded = true; rows('Translations').forEach(function (r) { known[r[0]] = r[3]; }); }
        if (known[key] !== undefined && known[key] !== '') { try { cache.put(ck(key), String(known[key]), 21600); } catch (e) { } return String(known[key]); }
        if (Date.now() - started > 8000) return null; // keep each request short; the page asks again for the rest
        var tr;
        try { tr = LanguageApp.translate(x.t, 'en', lang, { contentType: x.html ? 'html' : 'text' }); } catch (e) { return null; }
        known[key] = tr; add.push([key, lang, x.t, tr]);
        try { cache.put(ck(key), tr, 21600); } catch (e) { }
        return tr;
      });
      if (add.length) {
        var lock = LockService.getScriptLock();
        if (lock.tryLock(5000)) {
          try { var sh = ss.getSheetByName('Translations'); sh.getRange(sh.getLastRow() + 1, 1, add.length, 4).setValues(add); } finally { lock.releaseLock(); }
        }
      }
      return out;
    },
    // "I'm stuck" requests change every few seconds, so they live in script properties
    // (fast to read), not in the Sheet. Key: help:<short id>. Never holds an email address.
    helpAll: function () {
      var all = PropertiesService.getScriptProperties().getProperties(), out = {};
      Object.keys(all).forEach(function (k) { if (k.indexOf('help:') === 0) out[k.slice(5)] = parse(all[k], null); });
      return out;
    },
    helpPut: function (id, obj) {
      var props = PropertiesService.getScriptProperties();
      if (obj) props.setProperty('help:' + id, JSON.stringify(obj)); else props.deleteProperty('help:' + id);
    }
  };
  return store;
}
